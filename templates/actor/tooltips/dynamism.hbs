<img src="{{img}}" alt="{{name}}" height="50"/>
<h1 class="hellas-tooltip-name">{{name}}</h1>
<table class="hellas-tooltip-table">
	<tbody>
	<tr><td>{{localize "HELLAS.dynamism.skillid.label"}}</td><td>{{skillName}}</td></tr>
	<tr><td>{{localize "HELLAS.dynamism.dod.label"}}</td><td>{{system.dod}}</td></tr>
	<tr><td>{{localize "HELLAS.dynamism.dodinfo.label"}}</td><td>{{{dodinfoHtml}}}</td></tr>
	<tr><td>{{localize "HELLAS.dynamism.range.label"}}</td><td>{{system.range}}</td></tr>
	<tr><td>{{localize "HELLAS.dynamism.other.label"}}</td><td>{{system.other}}</td></tr>
	<tr><td>{{localize "HELLAS.dynamism.tradition.label"}}</td><td>{{system.tradition}}</td></tr>
	<tr><td>{{localize "HELLAS.dynamism.duration.label"}}</td><td>{{system.duration}}</td></tr>
	</tbody>
</table>
<div class="hellas-tooltip-notes">{{{system.notes}}}</div>

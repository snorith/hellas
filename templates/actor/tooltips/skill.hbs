<img src="{{img}}" alt="{{name}}" height="50"/>
<h1 class="hellas-tooltip-name">{{name}}</h1>
<table class="hellas-tooltip-table">
	<tbody>
	<tr><td>{{localize "HELLAS.skill.column.level"}}</td><td>{{system.level.value}}</td></tr>
	<tr><td>{{localize "HELLAS.skill.column.attr"}}</td><td>{{system.attribute}}</td></tr>
	<tr><td>{{localize "HELLAS.skill.column.rating"}}</td><td>{{system.level.max}}</td></tr>
	</tbody>
</table>
<div class="hellas-tooltip-notes">{{{system.notes}}}</div>

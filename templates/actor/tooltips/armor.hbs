<img src="{{img}}" alt="{{name}}" height="50"/>
<h1 class="hellas-tooltip-name">{{name}}</h1>
<table class="hellas-tooltip-table">
	<tbody>
	<tr><td>{{localize "HELLAS.armor.type.label"}}</td><td>{{typeName}}</td></tr>
	<tr><td>{{localize "HELLAS.armor.modifier.label"}}</td><td>{{modifierName}}</td></tr>
	<tr><td>{{localize "HELLAS.armor.pr.label"}}</td><td>{{system.pr}}</td></tr>
	<tr><td>{{localize "HELLAS.armor.str.label"}}</td><td>{{system.str}}</td></tr>
	<tr><td>{{localize "HELLAS.armor.parry.label"}}</td><td>{{system.parry}}</td></tr>
	<tr><td>{{localize "HELLAS.armor.md.label"}}</td><td>{{system.md}}</td></tr>
	<tr><td>{{localize "HELLAS.armor.per.label"}}</td><td>{{system.per}}</td></tr>
	<tr><td>{{localize "HELLAS.armor.cha.label"}}</td><td>{{system.cha}}</td></tr>
	<tr><td>{{localize "HELLAS.armor.wt.label"}}</td><td>{{system.wt}}</td></tr>
	<tr><td>{{localize "HELLAS.armor.price.label"}}</td><td>{{system.price}}</td></tr>
	</tbody>
</table>
<div class="hellas-tooltip-notes">{{{system.notes}}}</div>

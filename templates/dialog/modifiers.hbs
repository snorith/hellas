<div class="hellas-roll-modifiers">
	<div class="form-group">
		<label for="hellas-roll-dod">
			{{localize "HELLAS.roll.modifiers.dialog.dod.label"}}
			<i class="fas fa-info-circle" data-tooltip-html="{{localize "HELLAS.roll.modifiers.dialog.dod.tooltip"}}"></i>
		</label>
		<input type="number" id="hellas-roll-dod" name="dod" value="{{dod}}" step="1"
			   title="{{localize "HELLAS.roll.modifiers.dialog.dod.title"}}"/>
	</div>
	<div class="form-group">
		<label for="hellas-roll-nonproficiency"
			   title="{{localize "HELLAS.roll.modifiers.dialog.nonproficiency.title"}}">{{localize "HELLAS.roll.modifiers.dialog.nonproficiency.label"}}</label>
		<input type="number" id="hellas-roll-nonproficiency" name="nonproficiency" value="0" step="1"
			   title="{{localize "HELLAS.roll.modifiers.dialog.nonproficiency.title"}}"/>
	</div>
	<div class="form-group">
		<label for="hellas-roll-multipleactionscount"
			   title="{{localize "HELLAS.roll.modifiers.dialog.multipleactionscount.title"}}">{{localize "HELLAS.roll.modifiers.dialog.multipleactionscount.label"}}</label>
		<select id="hellas-roll-multipleactionscount" name="multipleactionscount"
				title="{{localize "HELLAS.roll.modifiers.dialog.multipleactionscount.title"}}">
			{{#each actionCounts}}
				<option value="{{this}}">{{this}}</option>
			{{/each}}
		</select>
	</div>
	<div class="form-group">
		<label for="hellas-roll-modifier"
			   title="{{localize "HELLAS.roll.modifiers.dialog.modifier.title"}}">{{localize "HELLAS.roll.modifiers.dialog.modifier.label"}}</label>
		<input type="number" id="hellas-roll-modifier" name="modifier" value="{{baseModifier}}" step="1"
			   title="{{localize "HELLAS.roll.modifiers.dialog.modifier.title"}}"/>
	</div>
</div>
